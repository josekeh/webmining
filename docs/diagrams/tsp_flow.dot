digraph TSPFlow {
  rankdir=LR;
  fontname="Helvetica";
  node [shape=box, style="rounded,filled", fillcolor="#F8FAFC", color="#334155", fontname="Helvetica"];
  edge [color="#475569", fontname="Helvetica"];

  input [label="Dataset depot (nodos + matrices)"];
  load [label="Carga con data_loader.py"];
  choose [label="Elegir criterio y orden de tipos"];
  combos [label="Generar combinaciones de nodos"];
  schedule [label="Validar horarios y estadias"];
  score [label="Evaluar costo/puntaje"];
  select [label="Seleccionar mejor ruta"];
  status [shape=diamond, label="¿Ruta factible encontrada?"];
  extract [label="Mostrar mapa, tablas y exportes"];
  review [label="Ajustar parametros / reintentar"];

  input -> load -> choose -> combos -> schedule -> score -> select -> status;
  status -> extract [label="Sí"];
  status -> review [label="No"];
}
