digraph DFD_Level_2_Opt {
  rankdir=LR;
  bgcolor="#F9FCFF";
  splines=true;
  fontname="Helvetica";
  graph [pad="0.28", nodesep="0.45", ranksep="0.7"];
  node [fontname="Helvetica", fontsize=10, style="rounded,filled", color="#2E5673", penwidth=1.3];
  edge [fontname="Helvetica", fontsize=9, color="#486581", penwidth=1.1, arrowsize=0.8];

  in_cfg [shape=parallelogram, fillcolor="#DDF2FF", label="Input\ncriterio, orden, estadias, hora salida"];
  in_data [shape=parallelogram, fillcolor="#DDF2FF", label="Input\nnodos + distancias + tiempos"];

  p31 [shape=box, fillcolor="#FFE2A9", label="P3.1\nGenerar rutas candidatas\n(combinaciones por tipo)"];
  p32 [shape=box, fillcolor="#FFCFB8", label="P3.2\nValidar factibilidad\npor ventanas horarias"];
  p33 [shape=box, fillcolor="#C5EAD9", label="P3.3\nEvaluar costo/puntaje\nde cada ruta"];
  p34 [shape=box, fillcolor="#B9D8FF", label="P3.4\nSeleccionar mejor ruta\nsegun criterio"];

  d_tmp [shape=cylinder, fillcolor="#EEF2FF", label="D3\nCandidatas factibles"];
  out_ok [shape=parallelogram, fillcolor="#D8F5D0", label="Output\nmejor ruta + schedule"];
  out_no [shape=parallelogram, fillcolor="#FFD5D5", label="Output\nno factible"];

  in_cfg -> p31;
  in_data -> p31;
  p31 -> p32;
  p32 -> d_tmp [label="si factible"];
  p32 -> out_no [label="si no factible"];
  d_tmp -> p33;
  p33 -> p34;
  p34 -> out_ok;
}
